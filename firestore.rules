rules_version = '2';
// Reglas de la Matriz de visita áulica RCTX · Eight Academy
// IMPORTANTE: si usas el MISMO proyecto de Firebase que la bitácora de observación,
// no reemplaces sus reglas. Copia solo el bloque "MATRIZ RCTX" dentro de las reglas
// que ya tienes publicadas (dentro de match /databases/{database}/documents { ... }).
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== MATRIZ RCTX (inicio) =====
    function rctxSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function rctxEmail() { return request.auth.token.email.lower(); }
    // Súper administración, en minúsculas. Debe coincidir con SUPER_ADMIN_EMAILS de docs/firebase-config.js
    function rctxSuper() { return rctxSignedIn() && rctxEmail() in ['dsroblesl@eightacademy.edu.ec']; }
    // Evaluadores (debe coincidir con EVALUADOR_EMAILS). La súper administración también evalúa.
    function rctxEval() { return rctxSuper() || (rctxSignedIn() && rctxEmail() in [
      'slbustamantel@eightacademy.edu.ec', 'lemaciasb@eightacademy.edu.ec', 'mibermeov@eightacademy.edu.ec']); }
    // Cualquier cuenta verificada del dominio institucional puede consultar.
    function rctxMember() { return rctxSignedIn() && rctxEmail().matches('^[^@]+@eightacademy[.]edu[.]ec$'); }

    // Códigos de la matriz versión 2.
    function rctxCodes() { return ['CG1','CG2','CG3','A1','C1','C2','K1','E1','D1','D2','D3','S1','S2']; }
    // Texto opcional con longitud máxima.
    function rctxStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }

    // Estructura válida de una visita: solo campos conocidos, sección y fecha válidas,
    // ID igual al del documento y autoría de quien escribe.
    function rctxVisitOk(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','token','version','seccion','fecha','observador','docente','docenteCorreo','curso','paralelo','materia','tema',
                               'horaInicio','horaFin','duracion','niveles','evidencias','pesos','fortalezas','mejoras',
                               'seguimiento','seguimientoHecho','seguimientoCancelado','seguimientoDe','conformidad','correoEnviado','fotos','puntajes','total','nivel',
                               'creado','actualizado','creadoPor','actualizadoPor'])
        && d.keys().hasAll(['id','version','seccion','fecha','docente','docenteCorreo','observador','niveles','total','nivel','actualizadoPor'])
        && d.id == id
        && id.matches('^VA-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,}$')
        && d.seccion in ['KIDS','PRIMARIA','SECUNDARIA']
        && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.version == 2
        && d.docenteCorreo is string && d.docenteCorreo.matches('^[^@]+@eightacademy[.]edu[.]ec$')
        && d.niveles is map && d.niveles.keys().hasOnly(rctxCodes())
        && (!('evidencias' in d) || (d.evidencias is map && d.evidencias.keys().hasOnly(rctxCodes())))
        && (!('pesos' in d) || (d.pesos is map && d.pesos.keys().hasOnly(rctxCodes()) && d.pesos.size() == 13))
        && (!('seguimientoHecho' in d) || d.seguimientoHecho == null || (d.seguimientoHecho is map && d.seguimientoHecho.keys().hasOnly(['fecha','por','visita'])))
        && (!('seguimientoCancelado' in d) || (d.seguimientoCancelado is map && d.seguimientoCancelado.keys().hasOnly(['fecha','por','motivo'])))
        && (!('seguimientoDe' in d) || (d.seguimientoDe is string && d.seguimientoDe.matches('^VA-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,}$')))
        && (!('fotos' in d) || (d.fotos is list && d.fotos.size() <= 2))
        && (!('correoEnviado' in d) || (d.correoEnviado is map && d.correoEnviado.keys().hasOnly(['fecha','por','a'])))
        && d.total is number && d.total >= 0 && d.total <= 100
        && d.nivel in ['SATISFACTORIO','CONFORME','INSATISFACTORIO','INCOMPLETA']
        && d.actualizadoPor == rctxEmail()
        && rctxStr(d, 'docente', 150) && rctxStr(d, 'observador', 150) && rctxStr(d, 'materia', 150)
        && rctxStr(d, 'curso', 60) && rctxStr(d, 'paralelo', 30) && rctxStr(d, 'tema', 300) && rctxStr(d, 'token', 64)
        && rctxStr(d, 'fortalezas', 5000) && rctxStr(d, 'mejoras', 5000);
    }
    // Conformidad escrita por el propio docente: una sola vez, solo ese campo, con su correo y la hora del servidor.
    function rctxConfByTeacher() {
      let c = request.resource.data.conformidad;
      return rctxMember()
        && resource.data.get('docenteCorreo', '') == rctxEmail()
        && !('conformidad' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conformidad'])
        && c is map && c.keys().hasOnly(['estado','texto','fecha','por'])
        && c.estado in ['CONFORME','OBSERVACIONES']
        && c.texto is string && c.texto.size() <= 2000
        && (c.estado == 'CONFORME' || c.texto.size() > 0)
        && c.por == rctxEmail()
        && c.fecha == request.time;
    }
    // Registro del envío de la evaluación por correo: solo ese campo, con el correo de quien envía y la hora del servidor.
    function rctxMailLog() {
      let m = request.resource.data.correoEnviado;
      return rctxEval()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['correoEnviado'])
        && m is map && m.keys().hasOnly(['fecha','por','a'])
        && m.por == rctxEmail() && m.fecha == request.time
        && m.a == resource.data.get('docenteCorreo', '');
    }
    // Cierre del seguimiento: solo ese campo, una vez, y solo si en la misma operación existe la visita nueva que lo declara como su origen.
    function rctxSegLink(id) {
      let h = request.resource.data.seguimientoHecho;
      return rctxEval()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seguimientoHecho'])
        && resource.data.get('seguimientoHecho', null) == null
        && resource.data.get('seguimientoCancelado', null) == null
        && h is map && h.keys().hasOnly(['fecha','por','visita'])
        && h.por == rctxEmail() && h.visita is string && h.visita != id
        && h.visita.matches('^VA-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,}$')
        && existsAfter(/databases/$(database)/documents/rctx_visitas/$(h.visita))
        && getAfter(/databases/$(database)/documents/rctx_visitas/$(h.visita)).data.get('seguimientoDe', '') == id;
    }

    match /rctx_visitas/{id} {
      allow read: if rctxMember();
      // Al crear, quien registra queda como autor. Una conformidad solo puede venir de un respaldo y queda marcada como restaurada.
      allow create: if rctxEval() && rctxVisitOk(id)
        && (request.resource.data.get('creadoPor', '') == rctxEmail() || rctxSuper())
        && (!('conformidad' in request.resource.data) || request.resource.data.conformidad.get('restaurada', false) == true)
        && (!('correoEnviado' in request.resource.data) || rctxSuper())
        && ((!('seguimientoHecho' in request.resource.data) && !('seguimientoCancelado' in request.resource.data)) || rctxSuper())
        && (!('seguimientoDe' in request.resource.data) || exists(/databases/$(database)/documents/rctx_visitas/$(request.resource.data.seguimientoDe)));
      // Al editar no se puede cambiar el autor, la fecha de creación, la conformidad del docente ni el registro de envío.
      // Los cierres puntuales (seguimiento, envío por correo, conformidad) se evalúan primero: si la edición completa
      // se evalúa antes y no aplica, puede invalidar toda la condición en vez de pasar a la siguiente.
      allow update: if rctxSegLink(id) || rctxMailLog() || rctxConfByTeacher() || (rctxEval() && rctxVisitOk(id)
          && (!('creadoPor' in resource.data) || request.resource.data.get('creadoPor', '') == resource.data.creadoPor)
          && (!('creado' in resource.data) || request.resource.data.get('creado', '') == resource.data.creado)
          && request.resource.data.get('conformidad', null) == resource.data.get('conformidad', null)
          && (request.resource.data.get('correoEnviado', null) == resource.data.get('correoEnviado', null) || rctxSuper())
          // El cierre o la cancelación del seguimiento y su origen no se cambian al editar (salvo la súper administración).
          && ((request.resource.data.get('seguimientoHecho', null) == resource.data.get('seguimientoHecho', null)
              && request.resource.data.get('seguimientoCancelado', null) == resource.data.get('seguimientoCancelado', null)
              && request.resource.data.get('seguimientoDe', null) == resource.data.get('seguimientoDe', null)) || rctxSuper()));
      allow delete: if rctxSuper();
    }
    match /rctx_fotos/{id} {
      allow read: if rctxMember();
      allow create, update: if rctxEval()
        && request.resource.data.keys().hasOnly(['fotos'])
        && request.resource.data.fotos is list && request.resource.data.fotos.size() <= 2;
      allow delete: if rctxSuper();
    }
    match /rctx_config/{id} {
      allow read: if rctxMember();
      allow write: if rctxSuper();
    }
    // Base de docentes por sede (correo para la visita y el envío de la evaluación).
    match /rctx_docentes/{id} {
      allow read: if rctxMember();
      allow create, update: if rctxEval()
        && request.resource.data.keys().hasOnly(['nombres','apellidos','correo','seccion','creadoPor','creado'])
        && request.resource.data.keys().hasAll(['nombres','apellidos','correo','seccion'])
        && request.resource.data.nombres is string && request.resource.data.nombres.size() > 0 && request.resource.data.nombres.size() <= 80
        && request.resource.data.apellidos is string && request.resource.data.apellidos.size() > 0 && request.resource.data.apellidos.size() <= 80
        && request.resource.data.correo is string
        && (request.resource.data.correo == '' || request.resource.data.correo.matches('^[^@]+@eightacademy[.]edu[.]ec$'))
        && request.resource.data.seccion in ['KIDS','PRIMARIA','SECUNDARIA']
        && rctxStr(request.resource.data, 'creadoPor', 150) && rctxStr(request.resource.data, 'creado', 40);
      allow delete: if rctxEval();
    }
    // Firma del docente (imagen PNG): una sola vez, de un evaluador o del propio docente, con la hora del servidor.
    match /rctx_firmas/{id} {
      allow read: if rctxMember();
      allow create: if exists(/databases/$(database)/documents/rctx_visitas/$(id))
        && (rctxEval() || (rctxMember() && get(/databases/$(database)/documents/rctx_visitas/$(id)).data.get('docenteCorreo', '') == rctxEmail()))
        && request.resource.data.keys().hasOnly(['img','fecha','por']) && request.resource.data.keys().hasAll(['img','fecha','por'])
        && request.resource.data.img is string && request.resource.data.img.size() < 300000
        && request.resource.data.img.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.por == rctxEmail() && request.resource.data.fecha == request.time;
      allow delete: if rctxSuper();
    }
    // Firma del evaluador (imagen PNG): una sola vez, solo de un evaluador o de la súper administración, con la hora del servidor.
    match /rctx_firmas_obs/{id} {
      allow read: if rctxMember();
      allow create: if exists(/databases/$(database)/documents/rctx_visitas/$(id)) && rctxEval()
        && request.resource.data.keys().hasOnly(['img','fecha','por']) && request.resource.data.keys().hasAll(['img','fecha','por'])
        && request.resource.data.img is string && request.resource.data.img.size() < 300000
        && request.resource.data.img.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.por == rctxEmail() && request.resource.data.fecha == request.time;
      allow delete: if rctxSuper();
    }
    // ===== MATRIZ RCTX (fin) =====
  }
}
